CLOUDCELL_HOST=127.0.0.1
CLOUDCELL_PORT=8080
CLOUDCELL_PUBLIC_URL=https://api.cloudcell.dev
CLOUDCELL_CORS_ORIGINS=https://cloudcell.dev,https://www.cloudcell.dev
CLOUDCELL_DATABASE_URL=sqlite:/var/lib/cloudcell/cloudcell.db
CLOUDCELL_DATA_DIR=/var/lib/cloudcell
CLOUDCELL_ROOTFS_DIR=/var/lib/cloudcell/snapshots
CLOUDCELL_SAND=/usr/local/bin/sand
RUST_LOG=info
